		if absf(a) < 0.126:
			var xx0: float = a * a
			var poly: float = (((G_S5 * xx0 + G_S4) * xx0 + G_S3) * xx0 + G_S2) * xx0 + G_S1
			r = a + ((poly * a - 0.5 * da) * xx0 + da)
		else:
			var d: float = -da if a <= 0.0 else da
			var aa: float = absf(a)
			var ur: float = (G_BIG + aa) - G_BIG
			var xr: float = aa - ur
			var xx: float = xr * xr
			var s: float = xr + (d + xr * xx * (G_SN3 + xx * G_SN5))
			var c: float = xr * d + xx * (G_CS2 + xx * (G_CS4 + xx * G_CS6))
			var k: int = int(ur * 128.0) << 2
			var sn: float = tab[k]
			var cs: float = tab[k + 2]
			var cor: float = (tab[k + 1] + s * tab[k + 3] - sn * c) + cs * s
			r = absf(sn + cor)
			if a < 0.0:
				r = -r
