## POW2[k + 1100] = 2^k for k in [-1100, 1100] (0 and infinity outside the range of a double).
static var POW2: PackedFloat64Array = _mkpow2()
## Result pair of the argument reductions: _red[0] = high part, _red[1] = low part.
static var _red: PackedFloat64Array = PackedFloat64Array([0.0, 0.0])


static func _mkbuf() -> PackedByteArray:
	var b: PackedByteArray = PackedByteArray()
	b.resize(8)
	return b


static func _mktab() -> PackedFloat64Array:
	var t: PackedFloat64Array = PackedFloat64Array()
	t.resize(SINCOSTAB_BITS.size())
	for i: int in range(SINCOSTAB_BITS.size()):
		t[i] = from_bits(SINCOSTAB_BITS[i] as int)
	return t


static func _mkpow2() -> PackedFloat64Array:
	var t: PackedFloat64Array = PackedFloat64Array()
	t.resize(2201)
	for k: int in range(-1100, 1101):
		var v: float = 0.0
		if k > 1023:
			v = INF
		elif k >= -1022:
			v = from_bits((k + 1023) << 52)
		elif k >= -1074:
			v = from_bits(1 << (k + 1074))
		t[k + 1100] = v
	return t


# ---------------------------------------------------------------------------------------------------
# Bit access
# ---------------------------------------------------------------------------------------------------

## The IEEE-754 bit pattern of x as a signed 64-bit int.
static func to_bits(x: float) -> int:
	_bb.encode_double(0, x)
	return _bb.decode_s64(0)


## The double with the given IEEE-754 bit pattern.
static func from_bits(bits: int) -> float:
	_bb.encode_s64(0, bits)
	return _bb.decode_double(0)


## High 32 bits of x as a signed int (fdlibm GET_HIGH_WORD).
static func _hi(x: float) -> int:
	_bb.encode_double(0, x)
	return _bb.decode_s32(4)


## Negative zero (a literal -0.0 evaluates to +0.0 in GDScript).
static func neg_zero() -> float:
	var z: float = 0.0
	return -z


# ---------------------------------------------------------------------------------------------------
# 32-bit integer semantics. JavaScript int32 values are held in GDScript ints, sign-extended; uint32 values in
# [0, 2^32). XOR, AND and OR of two sign-extended int32 values are again sign-extended int32 values.
# ---------------------------------------------------------------------------------------------------

## Wraps any int to the int32 range: ((v & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000.
static func i32(v: int) -> int:
	return ((v & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000


## ECMAScript ToInt32 (x | 0): truncate toward zero, then wrap modulo 2^32. NaN and the infinities give 0.
static func to_int32(x: float) -> int:
	if x >= -2147483648.0 and x <= 2147483647.0:
		return int(x)
	if is_nan(x) or is_inf(x):
		return 0
	var m: int = int(fmod(x, 4294967296.0)) & 0xFFFFFFFF
	return (m ^ 0x80000000) - 0x80000000


## ECMAScript ToUint32 (x >>> 0).
static func to_uint32(x: float) -> int:
	return to_int32(x) & 0xFFFFFFFF


## Math.imul(a, b) for integer arguments (any int: they are wrapped to int32 first). The product of two int32 values
## fits in 64 bits, so no information is lost before the final wrap.
static func imul(a: int, b: int) -> int:
	var p: int = (((a & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000) * (((b & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000)
	return ((p & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000


## a << n of JavaScript (the count is taken modulo 32).
static func shl(a: int, n: int) -> int:
	return i32(i32(a) << (n & 31))


## a >> n of JavaScript (arithmetic shift of the int32 value; the count is taken modulo 32).
static func sar(a: int, n: int) -> int:
	return i32(a) >> (n & 31)


## a >>> n of JavaScript (logical shift of the uint32 value; the count is taken modulo 32). Result in [0, 2^32).
static func shr_u(a: int, n: int) -> int:
	return (a & 0xFFFFFFFF) >> (n & 31)


# ---------------------------------------------------------------------------------------------------
# Rounding, remainder, min / max / clamp
# ---------------------------------------------------------------------------------------------------

## Math.round: ties go toward +Infinity, -0 and NaN are kept. V8's Float64Round: c = ceil(x); c - 0.5 <= x ? c : c - 1.
## (floor(x + 0.5) is wrong for 0.49999999999999994 and for odd values above 2^52; roundf rounds ties away from zero.)
static func js_round(x: float) -> float:
	var c: float = ceilf(x)
	if c - 0.5 <= x:
		return c
	return c - 1.0


## Math.trunc.
static func trunc(x: float) -> float:
	return ceilf(x) if x < 0.0 else floorf(x)


## a % b of JavaScript on numbers: the sign follows the dividend. This is fmod (float % float does not compile).
static func js_mod(a: float, b: float) -> float:
	return fmod(a, b)


## Math.max(a, b): NaN if either is NaN, and +0 beats -0.
static func js_max(a: float, b: float) -> float:
	if a > b:
		return a
	if b > a:
		return b
	if a == b:
		if a == 0.0 and 1.0 / a < 0.0:
			return b
		return a
	return NAN


## Math.min(a, b): NaN if either is NaN, and -0 beats +0.
static func js_min(a: float, b: float) -> float:
	if a < b:
		return a
	if b < a:
		return b
	if a == b:
		if a == 0.0 and 1.0 / a > 0.0:
			return b
		return a
	return NAN


static func max3(a: float, b: float, c: float) -> float:
	return js_max(js_max(a, b), c)


static func min3(a: float, b: float, c: float) -> float:
	return js_min(js_min(a, b), c)


static func max5(a: float, b: float, c: float, d: float, e: float) -> float:
	return js_max(js_max(js_max(js_max(a, b), c), d), e)


static func min5(a: float, b: float, c: float, d: float, e: float) -> float:
	return js_min(js_min(js_min(js_min(a, b), c), d), e)


## Math.max(...values): -Infinity for an empty array.
static func max_n(values: PackedFloat64Array) -> float:
	var r: float = -INF
	for v: float in values:
		r = js_max(r, v)
	return r


## Math.min(...values): +Infinity for an empty array.
static func min_n(values: PackedFloat64Array) -> float:
	var r: float = INF
	for v: float in values:
		r = js_min(r, v)
	return r


## The game's clamp(v, a, b) = Math.max(a, Math.min(b, v)). When lo > hi the result is lo (Godot's clampf gives hi),
## and NaN stays NaN.
static func clamp(v: float, lo: float, hi: float) -> float:
	var m: float
	if v < hi:
		m = v
	elif hi < v:
		m = hi
	else:
		m = js_min(hi, v)
	if m > lo:
		return m
	if lo > m:
		return lo
	return js_max(lo, m)


# ---------------------------------------------------------------------------------------------------
# IEEE-754 exact functions: the engine's own implementations are used.
# ---------------------------------------------------------------------------------------------------

## Math.sqrt (correctly rounded by IEEE 754). The call below is the engine's sqrt, not a recursion.
static func sqrt(x: float) -> float:
	return sqrt(x)


## Math.floor (exact).
static func floor(x: float) -> float:
	return floorf(x)


## Math.ceil (exact).
static func ceil(x: float) -> float:
	return ceilf(x)


## Math.abs (exact).
static func abs(x: float) -> float:
	return absf(x)


## Math.hypot(x, y) with two arguments, V8 14.1 FastMathHypot: scale by the larger magnitude, then
## sqrt((a/m)^2 + (b/m)^2) * m. (sqrt(x*x + y*y) differs in the last bit for a third of all inputs, and Vector2.length()
## is float32.)
static func hypot(x: float, y: float) -> float:
	var a: float = absf(x)
	var b: float = absf(y)
	if a == INF or b == INF:
		return INF
	if is_nan(a) or is_nan(b):
		return NAN
	var m: float = a if a > b else b
	if m == 0.0:
		return 0.0
	var ra: float = a / m
	var rb: float = b / m
	return sqrt(ra * ra + rb * rb) * m


# ---------------------------------------------------------------------------------------------------
# sin / cos: glibc s_sin.c (IBM Accurate Mathematical Library), the code behind Chromium's Math.sin / Math.cos.
# do_sin / do_cos / do_sincos / reduce_sincos are written out inside sin and cos (function calls cost more than the
# arithmetic); the structure is: reduce to a + da with |a| < pi/4 and a quadrant n, then evaluate sin or cos of (a, da)
# by a Taylor polynomial or by a table lookup at a multiple of 1/128.
# ---------------------------------------------------------------------------------------------------

## Math.sin (bit-exact with Chromium 141).
static func sin(x: float) -> float:
	var ax: float = absf(x)
	var a: float
	var da: float
	var n: int = 0
	var mid: bool = false
	if ax < G_TH_0855:
		if ax < G_TH_2M26:
			return x
		a = x
		da = 0.0
	elif ax < G_TH_2426:
		a = G_HP0 - ax
		da = G_HP1
		n = 1
		mid = true
	elif ax < G_TH_REDUCE:
