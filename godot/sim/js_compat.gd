		var xn: float = t0 - G_TOINT
		var y0: float = (x - xn * G_MP1) - xn * G_MP2
		n = int(xn) & 3
		var t1: float = xn * G_PP3
		var t2: float = y0 - t1
		var db: float = (y0 - t2) - t1
		t1 = xn * G_PP4
		a = t2 - t1
		db += (t2 - a) - t1
		da = db
	elif ax < INF:
		n = _branred(x)
		a = _red[0]
		da = _red[1]
	else:
		return NAN
	var r: float
	var tab: PackedFloat64Array = SINCOSTAB
