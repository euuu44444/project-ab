## Math.exp.
static func exp(x: float) -> float:
	if is_nan(x):
		return x + x
	var ax: float = absf(x)
	var xsb: int = 1 if x < 0.0 else 0
	if ax >= EX_TH_BIG:
		if ax == INF:
			return x if xsb == 0 else 0.0
		if x > EX_O_THRESHOLD:
			return INF
		if x < EX_U_THRESHOLD:
			return 0.0
	var hi: float = 0.0
	var lo: float = 0.0
	var k: int = 0
	if ax >= EX_TH_HALF_LN2:
		if ax < EX_TH_1_5_LN2:
			if x == 1.0:
				return EX_E
			if xsb == 0:
				hi = x - EX_LN2HI
				lo = EX_LN2LO
				k = 1
			else:
				hi = x + EX_LN2HI
				lo = -EX_LN2LO
				k = -1
		else:
			k = int(EX_INVLN2 * x + (-0.5 if xsb == 1 else 0.5))
			var tk: float = float(k)
			hi = x - tk * EX_LN2HI
			lo = tk * EX_LN2LO
		x = hi - lo
	elif ax < EX_TH_2M28:
		return 1.0 + x
	var t: float = x * x
	var c: float = x - t * (EX_P1 + t * (EX_P2 + t * (EX_P3 + t * (EX_P4 + t * EX_P5))))
	if k == 0:
		return 1.0 - ((x * c) / (c - 2.0) - x)
	var y: float = 1.0 - ((lo - (x * c) / (2.0 - c)) - hi)
	if k >= -1021:
		if k == 1024:
			return y * 2.0 * EX_TWO1023
		return y * POW2[k + 1100]
	return y * POW2[k + 1000 + 1100] * EX_TWOM1000


## Math.log.
static func log(x: float) -> float:
	_bb.encode_double(0, x)
	var hx: int = _bb.decode_s32(4)
	var lx: int = _bb.decode_u32(0)
	var k: int = 0
	if hx < 0x00100000:
		if ((hx & 0x7FFFFFFF) | lx) == 0:
			return -INF
		if hx < 0:
			return NAN
		k -= 54
		x *= LG_TWO54
		_bb.encode_double(0, x)
		hx = _bb.decode_s32(4)
	if hx >= 0x7FF00000:
		return x + x
	k += (hx >> 20) - 1023
	hx &= 0x000FFFFF
	var i: int = (hx + 0x95F64) & 0x100000
	_bb.encode_double(0, x)
	_bb.encode_s32(4, hx | (i ^ 0x3FF00000))
	x = _bb.decode_double(0)
	k += i >> 20
	var f: float = x - 1.0
	var dk: float
	if (0x000FFFFF & (2 + hx)) < 3:
		if f == 0.0:
			if k == 0:
				return 0.0
			dk = float(k)
			return dk * EX_LN2HI + dk * EX_LN2LO
		var r0: float = f * f * (0.5 - LG_THIRD * f)
		if k == 0:
			return f - r0
		dk = float(k)
		return dk * EX_LN2HI - ((r0 - dk * EX_LN2LO) - f)
	var s: float = f / (2.0 + f)
	dk = float(k)
	var z: float = s * s
	var i2: int = hx - 0x6147A
	var w: float = z * z
	var j: int = 0x6B851 - hx
	var t1: float = w * (LG_2 + w * (LG_4 + w * LG_6))
	var t2: float = z * (LG_1 + w * (LG_3 + w * (LG_5 + w * LG_7)))
	i2 |= j
	var r: float = t2 + t1
	if i2 > 0:
		var hfsq: float = 0.5 * f * f
		if k == 0:
			return f - (hfsq - s * (hfsq + r))
		return dk * EX_LN2HI - ((hfsq - (s * (hfsq + r) + dk * EX_LN2LO)) - f)
	if k == 0:
		return f - s * (f - r)
	return dk * EX_LN2HI - ((s * (f - r) - dk * EX_LN2LO) - f)


## Math.pow (also x ** y). NOT bit-guaranteed: the JavaScript special cases are handled here, the general case calls the
## platform's pow (glibc, Bionic), which V8 14.1 itself also uses (std::pow) apart from these cases. x ** 2 is x * x as in V8.
## Port the ARM optimized-routines pow if a trace ever diverges here; the simulation of milestone 1 does not call it.
static func pow(x: float, y: float) -> float:
	if is_nan(y):
		return NAN
	if y == 0.0:
		return 1.0
	if (x == 1.0 or x == -1.0) and is_inf(y):
		return NAN
	if y == 2.0:
		return x * x
	if y == 0.5:
		return INF if x == -INF else sqrt(x + 0.0)
	return pow(x, y)


# ---------------------------------------------------------------------------------------------------
# Self check
# ---------------------------------------------------------------------------------------------------

## Number of constants whose value differs from the bit pattern recorded in CONST_BITS (0 when everything is right),
## plus one for each table of the wrong size. A wrong constant would mean the GDScript parser mis-rounded a literal.
static func self_check() -> int:
	var bad: int = 0
	for pair: Array in CONST_BITS:
		if to_bits(float(pair[0])) != int(pair[1]):
			bad += 1
	if SINCOSTAB.size() != 440:
		bad += 1
	if TOVERP.size() != 75:
		bad += 1
	if POW2.size() != 2201:
		bad += 1
	return bad
