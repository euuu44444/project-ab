## Math.atan.
static func atan(x: float) -> float:
	if is_nan(x):
		return x + x
	var neg: bool = x < 0.0
	var ax: float = absf(x)
	if ax >= AT_TH_2P66:
		return AT_HI3 + AT_LO3 if x > 0.0 else -AT_HI3 - AT_LO3
	var id: int
	if ax < AT_TH_07:
		if ax < AT_TH_2M27:
			return x
		id = -1
	else:
		x = ax
		if ax < AT_TH_11:
			if ax < AT_TH_06:
				id = 0
				x = (2.0 * x - 1.0) / (2.0 + x)
			else:
				id = 1
				x = (x - 1.0) / (x + 1.0)
		elif ax < AT_TH_24:
			id = 2
			x = (x - 1.5) / (1.0 + 1.5 * x)
		else:
			id = 3
			x = -1.0 / x
	var z: float = x * x
	var w: float = z * z
	var s1: float = z * (AT_T0 + w * (AT_T2 + w * (AT_T4 + w * (AT_T6 + w * (AT_T8 + w * AT_T10)))))
	var s2: float = w * (AT_T1 + w * (AT_T3 + w * (AT_T5 + w * (AT_T7 + w * AT_T9))))
	if id < 0:
		return x - x * (s1 + s2)
	var hi: float
	var lo: float
	if id == 0:
		hi = AT_HI0
		lo = AT_LO0
	elif id == 1:
		hi = AT_HI1
		lo = AT_LO1
	elif id == 2:
		hi = AT_HI2
		lo = AT_LO2
	else:
		hi = AT_HI3
		lo = AT_LO3
	z = hi - ((x * (s1 + s2) - lo) - x)
	return -z if neg else z


## Math.atan2(y, x). The common case (both arguments finite, normal, |y/x| between 2^-59 and 2^59, x != 1) is
## evaluated directly; everything else (zeros, infinities, NaN, huge ratios, x == 1) goes through _atan2_general, the
## complete fdlibm routine.
static func atan2(y: float, x: float) -> float:
	var ax: float = absf(x)
	var ay: float = absf(y)
	if ax > TWO_M900 and ax < TWO_900 and ay > TWO_M900 and ay < TWO_900 and ay < ax * TWO_59 and ay > ax * TWO_M59 and x != 1.0:
		var t: float = ay / ax
		var z: float
		if t < AT_TH_07:
			if t < AT_TH_2M27:
				z = t
			else:
				var zz: float = t * t
				var w: float = zz * zz
				var s1: float = zz * (AT_T0 + w * (AT_T2 + w * (AT_T4 + w * (AT_T6 + w * (AT_T8 + w * AT_T10)))))
				var s2: float = w * (AT_T1 + w * (AT_T3 + w * (AT_T5 + w * (AT_T7 + w * AT_T9))))
				z = t - t * (s1 + s2)
		else:
			var hi: float
			var lo: float
			var u: float
			if t < AT_TH_11:
				if t < AT_TH_06:
					hi = AT_HI0
					lo = AT_LO0
					u = (2.0 * t - 1.0) / (2.0 + t)
				else:
					hi = AT_HI1
					lo = AT_LO1
					u = (t - 1.0) / (t + 1.0)
			elif t < AT_TH_24:
				hi = AT_HI2
				lo = AT_LO2
				u = (t - 1.5) / (1.0 + 1.5 * t)
			else:
				hi = AT_HI3
				lo = AT_LO3
				u = -1.0 / t
			var zz2: float = u * u
			var w2: float = zz2 * zz2
			var s3: float = zz2 * (AT_T0 + w2 * (AT_T2 + w2 * (AT_T4 + w2 * (AT_T6 + w2 * (AT_T8 + w2 * AT_T10)))))
			var s4: float = w2 * (AT_T1 + w2 * (AT_T3 + w2 * (AT_T5 + w2 * (AT_T7 + w2 * AT_T9))))
			z = hi - ((u * (s3 + s4) - lo) - u)
		if x > 0.0:
			return -z if y < 0.0 else z
		if y < 0.0:
			return (z - A2_PI_LO) - A2_PI
		return A2_PI - (z - A2_PI_LO)
	return _atan2_general(y, x)


## fdlibm __ieee754_atan2, all cases.
static func _atan2_general(y: float, x: float) -> float:
	if is_nan(x) or is_nan(y):
		return x + y
	if x == 1.0:
		return JsMath.atan(y)
	var yneg: bool = y < 0.0 or (y == 0.0 and 1.0 / y < 0.0)
	var xneg: bool = x < 0.0 or (x == 0.0 and 1.0 / x < 0.0)
	var m: int = (1 if yneg else 0) | (2 if xneg else 0)
	if y == 0.0:
		if m <= 1:
			return y
		if m == 2:
			return A2_PI + A2_TINY
		return -A2_PI - A2_TINY
	if x == 0.0:
		return -A2_PI_O_2 - A2_TINY if yneg else A2_PI_O_2 + A2_TINY
	var axx: float = absf(x)
	var ayy: float = absf(y)
	if axx == INF:
		if ayy == INF:
			if m == 0:
				return A2_PI_O_4 + A2_TINY
			if m == 1:
				return -A2_PI_O_4 - A2_TINY
			if m == 2:
				return 3.0 * A2_PI_O_4 + A2_TINY
			return -3.0 * A2_PI_O_4 - A2_TINY
		if m == 0:
			return 0.0
		if m == 1:
			return neg_zero()
		if m == 2:
			return A2_PI + A2_TINY
		return -A2_PI - A2_TINY
	if ayy == INF:
		return -A2_PI_O_2 - A2_TINY if yneg else A2_PI_O_2 + A2_TINY
	var k: int = ((_hi(y) & 0x7FFFFFFF) - (_hi(x) & 0x7FFFFFFF)) >> 20
	var z: float
	if k > 60:
		z = A2_PI_O_2 + 0.5 * A2_PI_LO
		m &= 1
	elif xneg and k < -60:
		z = 0.0
	else:
		z = JsMath.atan(absf(y / x))
	if m == 0:
		return z
	if m == 1:
		return -z
	if m == 2:
		return A2_PI - (z - A2_PI_LO)
	return (z - A2_PI_LO) - A2_PI


